# Infrastructure configuration — copy to .env.local (gitignored) for local overrides.
# Loaded automatically by src/fashion_recommendation_system/config.py on import.
# Feature/pipeline parameters live in configs/**/*.yaml.
#
# AWS auth: do NOT put access keys here. Use ~/.aws/credentials (or SSO profile in
# ~/.aws/config) and set AWS_PROFILE below when not using the default profile.

# AWS CLI profile name (optional). Omit or use `default` for ~/.aws/credentials [default].
AWS_PROFILE=default
AWS_REGION=us-east-1

# Object storage
S3_BUCKET=fashion-reco-dev
STORAGE_MODE=local
FE_LOCAL_S3_ROOT=../s3
FE_LOCAL_DATASET_ROOT=../dataset
LOCALSTACK_ENDPOINT=

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# ML inference (local dev defaults)
TWO_TOWER_ENDPOINT=http://localhost:8080
XGBOOST_ENDPOINT=http://localhost:8081
FAISS_LAMBDA_ARN=

# Experiment tracking & HPO (AWS Managed MLflow + Optuna RDS)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=fashion-reco-dev
OPTUNA_STORAGE_URI=
SAGEMAKER_ROLE_ARN=
MLFLOW_TRACKING_SERVER_NAME=fashion-reco-mlflow-dev
